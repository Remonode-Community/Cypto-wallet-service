# ============================================================
# Crypto Wallet Service - environment template
# Copy to .env:  cp .env.example .env
# Generate secrets:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ============================================================

# ---------- Application ----------
NODE_ENV=production
PORT=8000
CORS_ORIGIN=*
JWT_SECRET=change-me-64-char-random-string
JWT_EXPIRES_IN=1h

# ---------- MongoDB ----------
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=change-me-strong-password
MONGO_DB=crypto_wallet
MONGO_PORT=27017
# Replica-set keyFile value (one line, base64, 6-1024 chars).
# Generate: node -e "console.log(require('crypto').randomBytes(512).toString('base64'))"
MONGO_REPLSET_KEYFILE=change-me-random-base64-keyfile
MONGODB_URI=mongodb://admin:change-me-strong-password@mongo:27017/crypto_wallet?authSource=admin&replicaSet=rs0&retryWrites=true&w=majority

# ---------- Redis ----------
REDIS_PASSWORD=change-me-strong-password
REDIS_PORT=6379
REDIS_URL=redis://:change-me-strong-password@redis:6379/0
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=volatile-lru

# ---------- Nginx edge ----------
HTTP_PORT=80
# HTTPS_PORT=443
DEV_API_PORT=8000
